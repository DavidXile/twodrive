#!/usr/bin/make -f
ifneq (,$(filter pkg.twodrive.dav,$(DEB_BUILD_PROFILES)))
%:
	dh $@ --buildsystem=none --without autoreconf

# Keep the tested portable binaries byte-for-byte in the test package.
override_dh_dwz:
override_dh_strip:
override_dh_strip_nondeterminism:

override_dh_shlibdeps:
	dh_shlibdeps -- -l$(CURDIR)/debian/twodrive-dav/usr/lib/twodrive-dav/lib
else
export CARGO_HOME = $(CURDIR)/debian/cargo-home
export CARGO_TARGET_DIR = $(CURDIR)/debian/cargo-target
export CARGO_NET_OFFLINE = true
export CARGO_INCREMENTAL = 0
export CARGO_PROFILE_RELEASE_DEBUG = 2
# Debian uses its maintained SQLite while the Rust sources and schema stay fixed.
export LIBSQLITE3_SYS_USE_PKG_CONFIG = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/buildflags.mk
export RUSTFLAGS = $(shell dpkg-buildflags --get RUSTFLAGS) --remap-path-prefix=$(CURDIR)=/usr/src/twodrive
export CARGO_BUILD_JOBS = $(if $(filter parallel=%,$(DEB_BUILD_OPTIONS)),$(patsubst parallel=%,%,$(filter parallel=%,$(DEB_BUILD_OPTIONS))),1)
CARGO = cargo --config 'source.crates-io.replace-with="vendored-sources"' --config 'source.vendored-sources.directory="vendor"'

%:
	dh $@ --buildsystem=none --without autoreconf

override_dh_auto_build:
	$(CARGO) build --frozen --release -p twodrive-cli -p twodrive-daemon

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(CARGO) test --frozen --workspace
	python3 -m unittest discover -s packaging/nautilus -p 'test_*.py'
	python3 -m unittest discover -s scripts -p 'test_twodrive_settings.py'
	python3 -m unittest discover -s scripts -p 'test_release_assets.py'
endif

override_dh_auto_clean:
	rm -rf debian/cargo-target debian/cargo-home

override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# Cargo validates every vendored input, including upstream Cargo.toml.orig files.
# dh_clean normally deletes *.orig recursively; never modify this component.
override_dh_clean:
	dh_clean -Xvendor/

override_dh_update_autotools_config:
	:
endif
